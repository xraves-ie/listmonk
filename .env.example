# Local development/runtime configuration. Never put real credentials here.
LISTMONK_app__address=0.0.0.0:9000
LISTMONK_db__host=127.0.0.1
LISTMONK_db__port=5432
LISTMONK_db__user=dblistmonk
LISTMONK_db__password=replace-me
LISTMONK_db__database=dblistmonk
LISTMONK_db__ssl_mode=disable

# Zerops startup lifecycle: none (normal), install (first deploy), or upgrade.
XRAVES_DB_MODE=none

# Optional non-interactive first-install administrator. Prefer creating the
# initial administrator in the browser; if used, store these as Zerops secrets.
# LISTMONK_ADMIN_USER=admin
# LISTMONK_ADMIN_PASSWORD=replace-with-at-least-8-characters
